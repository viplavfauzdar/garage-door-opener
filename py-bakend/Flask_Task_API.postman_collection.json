                  "key": "Authorization",
                  "value": "Bearer {{refresh_token}}"
                }
              ],
              "url": {
                "raw": "{{base_url}}/api/auth/refresh",
                "host": ["{{base_url}}"],
                "path": ["api","auth","refresh"]
              }
            },
            "response": []
          }
        ]
      },
      {
        "name": "Error Cases",
        "item": [
          {
            "name": "Invalid Login",
            "request": {
              "method": "POST",
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json"
                }
              ],
              "body": {
